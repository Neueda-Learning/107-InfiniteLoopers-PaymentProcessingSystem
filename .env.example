# Copy this file to .env before running docker compose
# Do not commit the real .env file with secrets

MYSQL_DATABASE=payment_processing_db
MYSQL_USER=payment_user
MYSQL_PASSWORD=change_me_mysql_user_password
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password

SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=8080
DB_URL=jdbc:mysql://mysql:3306/payment_processing_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=payment_user
DB_PASSWORD=change_me_mysql_user_password

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
APP_MAIL_ENABLED=false

LOG_FILE=/app/logs/payment-processing-system.log

